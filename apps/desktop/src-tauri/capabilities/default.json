{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:allow-restart"
  ]
}
