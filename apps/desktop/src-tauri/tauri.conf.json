{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dahoko",
  "version": "0.2.0",
  "identifier": "dev.dahoko.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5103",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dahoko",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzM0EzODhBMTAxRjlGNjEKUldSaG54OFFpamc2RXpjMm5WK2xLQTk1SVBZcUF6L251bDNXdklwYXZGZlRqQ3FobE1tZnRldncK",
      "endpoints": [
        "https://github.com/megancooper/dahoko/releases/latest/download/latest.json"
      ]
    }
  }
}
