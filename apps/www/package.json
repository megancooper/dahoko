{
  "name": "@dahoko/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --noEmit",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name dahoko --branch main",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@dahoko/ui": "workspace:*",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@dahoko/typescript-config": "workspace:*",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.3",
    "vite": "6.0.0",
    "wrangler": "4.114.0"
  }
}
