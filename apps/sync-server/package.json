{
  "name": "@dahoko/sync-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "pnpm build && node dist/migrate-cli.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@dahoko/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "@types/pg": "8.15.4",
    "tsx": "4.23.1",
    "typescript": "5.7.3"
  }
}
